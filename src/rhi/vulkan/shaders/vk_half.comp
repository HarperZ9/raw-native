#version 460
// HW H1.0 (Vulkan): float16 arithmetic (shaderFloat16). Mirrors hw_half.hlsl: a * b + c in
// float16 from triples exact in half, and the 2048 + 1 flag that proves 16-bit rounding.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Src { float src[]; };
layout(std430, binding = 1) buffer Dst { float dst[]; };
void main() {
    const uint id = gl_GlobalInvocationID.x;
    const float16_t a = float16_t(src[3u * id]);
    const float16_t b = float16_t(src[3u * id + 1u]);
    const float16_t c = float16_t(src[3u * id + 2u]);
    dst[id + 1u] = float(a * b + c);
    if (id == 0u) {
        const float16_t big = float16_t(src[0] * 0.0 + 2048.0);
        const float16_t one = float16_t(src[1] * 0.0 + 1.0);
        dst[0] = ((big + one) == big) ? 1.0 : 0.0;
    }
}
