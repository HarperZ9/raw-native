    float bd = 1.0e30f;
    for (uint k = 0u; k < U.palSize; k++) {
        const float d = length(lab - pal[k].xyz);
        if (d < bd) {
            bd = d;
            best = int(k);
        }
    }
    return best;
}
bool keep(float3 lab, int p, int pl) {
    if (U.mode == 0u) {
        const float x = lab.x * U.a.x;
        return x >= float(p) - 0.5f - U.a.y && x <= float(p) + 0.5f + U.a.y;
    }
    return length(lab - pal[uint(p)].xyz) <= length(lab - pal[uint(pl)].xyz) + U.a.y;
}

[numthreads(64, 1, 1)]
void main(uint3 gid : SV_DispatchThreadID) {
    const uint i = gid.x;
    if (i >= U.width * U.height) { return; }
    const int w = int(U.width);
    const int h = int(U.height);
    const int x = int(i % U.width);
    const int y = int(i / U.width);
    const float3 c = img[i].xyz;
    const float3 lab = to_oklab(float3(shoulder(c.x), shoulder(c.y), shoulder(c.z)));
    const int pl = plain_decision(lab);
    int d = pl;
    float cnt = 0.0f;
    const float4 mo = motion[i];
    if (U.on > 0u && U.hasState > 0u) {
        float mx = 0.0f;
        float my = 0.0f;
        if (U.hasMotion > 0u) {
            mx = mo.x;
            my = mo.y;
        }
        const int px = int(floor(float(x) + 0.5f - mx));
        const int py = int(floor(float(y) + 0.5f - my));
        if (px >= 0 && py >= 0 && px < w && py < h) {
            const float4 s = prev[uint(py * w + px)];
            const float expect = mo.z;
            if (abs(s.z - expect) <= U.a.w * expect) {
                const int pv = int(floor(s.x + 0.5f));
                if (pv != pl && keep(lab, pv, pl)) {
                    const float cc = s.y + 1.0f;
                    if (cc < U.b.x) {
                        d = pv;
                        cnt = cc;
                    }
                }
            }
        }
    }
    next[i] = float4(float(d), cnt, mo.w, 0.0f);
    float3 rgb = ((float3)(0.0f));
    if (U.mode == 0u) {
        const float Lq = float(d) / U.a.x;
        float sc = 0.0f;
        if (lab.x > 1.0e-9f) { sc = Lq / lab.x; }
        rgb = from_oklab(float3(Lq, lab.y * sc, lab.z * sc));
    } else {
        rgb = from_oklab(pal[uint(d)].xyz);
    }
    out8[i] = pack_rgb8(rgb);
}
