            const float g = ggx_d(h, ax, ay) * smith_v(o, im, ax, ay) + (1.0f - abo.x - abo.y) * (1.0f - abm.x - abm.y) / (PI * (1.0f - ebar)) * ms_on;
            f = base * min(((float3)(1.0f)) - es_o, ((float3)(1.0f)) - es_i) * (g * tr * (1.0f - mt));
