}

[numthreads(64, 1, 1)]
void main(uint3 gid : SV_DispatchThreadID) {
    const uint k = gid.x;
    if (k >= P.count) { return; }
    const uint b = k * SAMPLE;
    const float3 p = cv3(b, 36u);
    const float3 n = cv3(b, 39u);
    const float3 t = cv3(b, 42u);
    const float3 v = cv3(b, 45u);
    const float3 bt = cross(n, t);
    const float3 wo = float3(dot(v, t), dot(v, bt), dot(v, n));
    float3 sum = cv3(b, 31u) * C[b + 34u];
    const int c = cluster_of(p, P.grid);
    if (c >= 0) {
        const uint cnt = K[uint(c)];
        for (uint j = 0u; j < cnt; j++) {
            const uint li = K[NCLUSTERS + uint(c) * MAX_PER_CLUSTER + j];
            float3 dl = ((float3)(0.0f));
            const float3 e = illum(li, p, dl);
            if (e.x == 0.0f && e.y == 0.0f && e.z == 0.0f) { continue; }
            const float3 wi = float3(dot(dl, t), dot(dl, bt), dot(dl, n));
            sum = sum + eval_case(b, wo, wi) * e * abs(wi.z);
        }
    }
    const float3 o = (sum + ibl(b, wo, n, t, v)) * P.misc.x;
    const uint r = k * 3u;
    R[r] = o.x; R[r + 1u] = o.y; R[r + 2u] = o.z;
}
