    float coat = 0.0f;
    const float rc = clamp(C[b + 11u], MIN_ROUGH, 1.0f);
    if (c > 0.0f) {
        const float mu = max(dot(pnorm(cv3(b, 12u)), wo), 0.0f);
        const float kc = kms(0.04f + 0.96f / 21.0f, tab_eavg(rc));
        const float ac = read2(OFF_A, N_THETA, N_ROUGH, mu, rc);
        const float bc = read2(OFF_B, N_THETA, N_ROUGH, mu, rc);
        const float ec = 0.04f * ac + bc + (1.0f - ac - bc) * kc;
