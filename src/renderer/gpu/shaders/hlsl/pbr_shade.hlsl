    if (pmax3(trans) > 0.0f) {
        float3 td = -v;
        if (C[b + 20u] != 0.0f) {
            const float eta = 1.0f / C[b + 5u];
            const float cs = dot(n, v);
            const float k = 1.0f - eta * eta * (1.0f - cs * cs);
            td = ((k < 0.0f) ? (-v + 2.0f * cs * n) : (eta * (-v) + (eta * cs - sqrt(max(k, 0.0f))) * n));
        }
        acc = acc + trans * env_rough(rr, td);
    }
    if (coat > 0.0f) {
        const float3 bt = cross(n, t);
        const float3 cl = cv3(b, 12u);
        const float3 cn = pnorm(t * cl.x + bt * cl.y + n * cl.z);
        acc = acc + ((float3)(coat)) * env_rough(rc, dominant(cn, v, rc));
