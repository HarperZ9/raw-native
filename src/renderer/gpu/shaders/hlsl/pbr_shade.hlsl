    const float3 i = float3(cr * wi.x + sr * wi.y, -sr * wi.x + cr * wi.y, wi.z);
    const float2 abo = split_ab(o, rr, ak);
    const float2 abi = split_ab(i, rr, ak);
    const float3 es_o = es_at(abo, f0d, f90, kd);
    const float3 es_i = es_at(abi, f0d, f90, kd);
    const float tr = clamp(C[b + 19u], 0.0f, 1.0f);
    float3 f = ((float3)(0.0f));
    if (i.z > 0.0f) {
        const float3 h = pnorm(o + i);
        const float dv = ggx_d(h, ax, ay) * smith_v(o, i, ax, ay);
        const float voh = pdot(o, h);
        const float ms = (1.0f - abo.x - abo.y) * (1.0f - abi.x - abi.y) / (PI * (1.0f - ebar)) * ms_on;
        f = (fresnel3(base, 1.0f, voh, b) * mt + fresnel3(f0d, f90, voh, b) * (1.0f - mt)) * dv;
        f = f + (km * mt + kd * (1.0f - mt)) * ms;
