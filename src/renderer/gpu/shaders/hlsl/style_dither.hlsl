    const uint p = gid.x;
    if (p >= U.width * U.height) { return; }
    const uint x = p % U.width;
    const uint y = p / U.width;
    const uint mode = U.mode;
    const uint c = src[p];
    const float2 r = K[c & 255u];
    const float2 g = K[(c >> 8u) & 255u];
    const float2 b = K[(c >> 16u) & 255u];
    float2 L0 = ((float2)(0.0f));
    float2 A = ((float2)(0.0f));
    float2 Bv = ((float2)(0.0f));
    lab3(r, g, b, L0, A, Bv);
    const float2 L = ds_clamp01(ds_add(L0, K[279u]));
    uint i = nearest(L, A, Bv);
    const float2 strength = K[280u];
