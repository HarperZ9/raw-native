            i = mix_pick(r, g, b, th);
        }
        idx[p] = i;
        out8[p] = palrgb[i];
        return;
    }
    if (mode != 0u && U.n >= 2u && ds_gt(strength, ds(0.0f))) {
        const int j = far_side(L, A, Bv, i);
        if (j >= 0) {
            const uint ju = uint(j);
            const float2 sL = ds_sub(palc(ju, 0u), palc(i, 0u));
            const float2 sa = ds_sub(palc(ju, 1u), palc(i, 1u));
            const float2 sb = ds_sub(palc(ju, 2u), palc(i, 2u));
            const float2 len2 = ds_add(ds_add(ds_mul(sL, sL), ds_mul(sa, sa)), ds_mul(sb, sb));
            if (!ds_lt(len2, K[274u])) {
                const float2 num = ds_add(ds_add(ds_mul(ds_sub(L, palc(i, 0u)), sL), ds_mul(ds_sub(A, palc(i, 1u)), sa)), ds_mul(ds_sub(Bv, palc(i, 2u)), sb));
