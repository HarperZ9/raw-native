float pt_noise(uint kind, float x, float y) {
    if (kind == 0u) { return 0.7f * pt_vnoise(x / 1.3f, y / 1.3f, 53u) + 0.3f * pt_vnoise(x / 5.0f, y / 5.0f, 59u); }
    if (kind == 1u) { return pt_vnoise(x / 6.0f, y / 6.0f, 67u); }
    if (kind == 2u) { return 0.5f + 0.25f * sin(6.283185307179586f * x / 3.2f) * cos(6.283185307179586f * y / 3.2f) + 0.25f * (pt_vnoise(x / 1.5f, y / 1.5f, 61u) - 0.5f); }
    if (kind == 3u) { return pt_paper(x, y); }
    if (kind == 4u) { return pt_paper(x / 2.0f, y / 2.0f); }
    if (kind == 5u) { return 2.0f * pt_vnoise(x / 23.0f, y / 23.0f, 71u) - 1.0f; }
    return 2.0f * pt_vnoise(x / 23.0f, y / 23.0f, 73u) - 1.0f;
}
float pt_smooth(float a, float b, float x) {
    const float t = clamp((x - a) / (b - a), 0.0f, 1.0f);
    return t * t * (3.0f - 2.0f * t);
}
float3 pt_major(float e, float f, float g) {
    const float tr = e + g;
    const float l1 = (tr + sqrt((e - g) * (e - g) + 4.0f * f * f)) / 2.0f;
    const float2 a = float2(f, l1 - e);
    const float2 b = float2(l1 - g, f);
    const float na = length(a);
    const float nb = length(b);
    if (na >= nb) { return float3(a, na); }
    return float3(b, nb);
}
float3 pt_flow(float4 T) {
    const float E = T.x;
    const float F = T.y;
    const float G = T.z;
    const float tr = E + G;
    const float dsc = sqrt((E - G) * (E - G) + 4.0f * F * F);
    const float l1 = (tr + dsc) / 2.0f;
    const float l2 = (tr - dsc) / 2.0f;
    const float sh = clamp((tr - 1.0e-7f) / 9.0e-7f, 0.0f, 1.0f);
    float A = 0.0f;
    if (tr > 1.0e-12f) { A = (l1 - l2) / (l1 + l2) * sh * sh * (3.0f - 2.0f * sh); }
    const float s = clamp((A - 0.02f) / 0.08f, 0.0f, 1.0f);
    const float k = s * s * (3.0f - 2.0f * s);
    float inv = 0.0f;
    if (tr > 1.0e-12f) { inv = 1.0f / tr; }
    const float3 m = pt_major(k * E * inv + (1.0f - k) * 0.5f, k * F * inv - (1.0f - k) * 0.5f, k * G * inv + (1.0f - k) * 0.5f);
    if (m.z <= 1.0e-12f) { return float3(0.7071067811865476f, 0.7071067811865476f, A); }
    return float3(-m.y / m.z, m.x / m.z, A);
}

float bayer4(uint x, uint y) {
    const uint i = (y & 3u) * 4u + (x & 3u);
    const float4 a = float4(0.0f, 8.0f, 2.0f, 10.0f);
    const float4 b = float4(12.0f, 4.0f, 14.0f, 6.0f);
    const float4 c = float4(3.0f, 11.0f, 1.0f, 9.0f);
    const float4 d = float4(15.0f, 7.0f, 13.0f, 5.0f);
    if (i < 4u) { return a[i]; }
    if (i < 8u) { return b[i - 4u]; }
    if (i < 12u) { return c[i - 8u]; }
    return d[i - 12u];
}

[numthreads(64, 1, 1)]
void main(uint3 gid : SV_DispatchThreadID) {
    const uint p = gid.x;
    if (p >= U.width * U.height) { return; }
    const uint x = p % U.width;
    const uint y = p / U.width;
    const bool use_prev = U.has_prev != 0u && (bayer4(x, y) + 0.5f) / 16.0f >= U.a.w;
    uint t = idb0[p];
    if (use_prev) { t = idb1[p]; }
    float3 c = ((float3)(0.0f));
    if (t != 0xffffffffu) {
        if (use_prev) { c = col1[t].xyz; } else { c = col0[t].xyz; }
    } else {
        const float W = float(U.width);
        const float H = float(U.height);
        const float sx = (2.0f * (float(x) + 0.5f) / W - 1.0f) * U.eye.w * (W / H);
        const float sy = (1.0f - 2.0f * (float(y) + 0.5f) / H) * U.eye.w;
        const float3 d = normalize(U.f.xyz + sx * U.r.xyz + sy * U.u.xyz);
        const float3 e = U.eye.xyz;
        const float3 hit = px_march(e, d, 40.0f);
        if (hit.x < 0.0f) {
            c = px_stylise(px_sky(d), U.origin.w, 0.0f);
        } else {
            const float3 q = e + d * hit.x;
            c = px_stylise(px_shade(q, px_normal(q), int(hit.y)), U.origin.w, 0.0f);
        }
    }
    out8[p] = pack_rgb8(c);
}
