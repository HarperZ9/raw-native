    const float ms_on = (((P.flags & FLAG_NO_MS) != 0u) ? (0.0f) : (1.0f));
    const float3 base = cv3(b, 0u);
    const float mt = clamp(C[b + 3u], 0.0f, 1.0f);
    const float rr = clamp(C[b + 4u], MIN_ROUGH, 1.0f);
    const float ak = clamp(C[b + 26u], 0.0f, 1.0f);
    const float a = alpha_of(C[b + 4u]);
