[numthreads(64, 1, 1)]
void main(uint3 gid : SV_DispatchThreadID) {
    const uint k = gid.x;
    if (k >= P.count) { return; }
    const uint b = k * CASE;
    const float3 wo = cv3(b, 36u);
    const float3 wi = cv3(b, 39u);
    const float3 f = eval_case(b, wo, wi) * abs(wi.z);
    const float3 e = cv3(b, 31u) * C[b + 34u];
    const uint o = k * 6u;
    R[o] = f.x; R[o + 1u] = f.y; R[o + 2u] = f.z;
    R[o + 3u] = e.x; R[o + 4u] = e.y; R[o + 5u] = e.z;
}
