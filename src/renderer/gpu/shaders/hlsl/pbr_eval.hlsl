    const float abar = ((ak > 0.0f) ? (read2rk(OFF_AAVG2, rr, ak)) : (read1(OFF_AAVG, N_ROUGH, rr)));
    const float bbar = ((ak > 0.0f) ? (read2rk(OFF_BAVG2, rr, ak)) : (read1(OFF_BAVG, N_ROUGH, rr)));
