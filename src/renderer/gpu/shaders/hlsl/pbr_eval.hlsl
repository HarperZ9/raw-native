    const float3 km = kms3(base, 1.0f, ebar);
    const float3 kd = kms3(f0d, f90, ebar);
    const float3 es_avg = f0d * abar + ((float3)(f90 * bbar)) + (1.0f - ebar) * kd;
    const float cr = C[b + 27u];
    const float sr = C[b + 35u];
    const float3 o = float3(cr * wo.x + sr * wo.y, -sr * wo.x + cr * wo.y, wo.z);
    const float3 i = float3(cr * wi.x + sr * wi.y, -sr * wi.x + cr * wi.y, wi.z);
    const float2 abo = split_ab(o, rr, ak);
    const float2 abi = split_ab(i, rr, ak);
