        float3 rd = cam_dir(float(gid.x) + j.x, float(gid.y) + j.y, P.eye, P.fwd, P.side, P.up);
        float3 tp = ((float3)(1.0f));
        float3 l = ((float3)(0.0f));
        float prevPdf = 0.0f;
        // v2 split (addendum 5): ld, lsp, le0 at the first hit; rr gathers later contributions by
        // tw, the throughput relative to the first BSDF sample, split at the end by wd and ws.
        float3 ld = ((float3)(0.0f));
        float3 lsp = ((float3)(0.0f));
        float3 le0 = ((float3)(0.0f));
        float3 rr = ((float3)(0.0f));
        float3 tw = ((float3)(1.0f));
        float3 wd = ((float3)(0.0f));
        float3 ws = ((float3)(0.0f));
        for (uint b = 0u; b <= P.maxBounces; b++) {
            const float4 h = trace(ro, rd, BIG, false);
            if (h.w < 0.0f) {
                l = l + tp * P.sky.xyz;
                if (b == 0u) { le0 = P.sky.xyz; } else { rr = rr + tw * P.sky.xyz; }
                break;
            }
            const uint t = uint(h.w);
            const float3 bc = float3(1.0f - h.y - h.z, h.y, h.z);
            const float3 p = ro + rd * h.x;
            float3 ng = normalize(cross(vtx(t, 1u) - vtx(t, 0u), vtx(t, 2u) - vtx(t, 0u)));
            float3 n = normalize(float3(attr(t, 2u, bc), attr(t, 3u, bc), attr(t, 4u, bc)));
            const uint tex = uint(A[t * 16u + 15u]);
            const uint mb = tex * 8u;
            const float3 base = texel(tex, attr(t, 0u, bc), attr(t, 1u, bc)) * (M[mb] / 255.0f);
            if (dot(ng, rd) > 0.0f) { ng = -ng; }
            if (dot(n, ng) < 0.0f) { n = -n; }
            if (b == 0u) {
                ACC[o + 6u] = ACC[o + 6u] + base.x; ACC[o + 7u] = ACC[o + 7u] + base.y; ACC[o + 8u] = ACC[o + 8u] + base.z;
                ACC[o + 9u] = ACC[o + 9u] + n.x; ACC[o + 10u] = ACC[o + 10u] + n.y; ACC[o + 11u] = ACC[o + 11u] + n.z;
                const float3 da = base * (1.0f - M[mb + 2u]);
                const float3 sa = spec_albedo(base, M[mb + 2u], M[mb + 3u], clamp(-dot(n, rd), 0.0f, 1.0f));
                ACC[o + 25u] = ACC[o + 25u] + da.x; ACC[o + 26u] = ACC[o + 26u] + da.y; ACC[o + 27u] = ACC[o + 27u] + da.z;
                ACC[o + 28u] = ACC[o + 28u] + sa.x; ACC[o + 29u] = ACC[o + 29u] + sa.y; ACC[o + 30u] = ACC[o + 30u] + sa.z;
            }
            const float3 le = float3(M[mb + 4u], M[mb + 5u], M[mb + 6u]);
            if (max(le.x, max(le.y, le.z)) > 0.0f) {
                float w = 1.0f;
                if (b > 0u && !misOne) {
                    const float pl = h.x * h.x / (abs(dot(ng, rd)) * P.emitterArea);
                    w = prevPdf * prevPdf / (prevPdf * prevPdf + pl * pl);
                }
                l = l + tp * le * w;
                if (b == 0u) { le0 = le; } else { rr = rr + tw * le * w; }
            }
            if (b == P.maxBounces) { break; }
            const float3 tb = basis_t(n);
            const float3 bb = basis_b(n);
            const float3 wo = float3(dot(-rd, tb), dot(-rd, bb), dot(-rd, n));
            if (wo.z <= 0.0f) { break; }
            const float rough = M[mb + 1u];
            const float metal = M[mb + 2u];
            const float spec = M[mb + 3u];
            const uint dim = 2u + b * 4u;
            // Next-event estimation: the sun, then one emitter sample.
            if (P.sun.w > 0.0f) {
                const float3 ls = P.sun.xyz;
                const float4 es = eval_bsdf(base, rough, metal, spec, wo, float3(dot(ls, tb), dot(ls, bb), dot(ls, n)), dropCos);
                if (max(es.x, max(es.y, es.z)) > 0.0f) {
                    if (trace(offset_p(p, ng, ls), ls, BIG, true).w < 0.0f) {
                        l = l + tp * es.xyz * P.sunIrr.xyz;
                        if (b == 0u) {
                            const float3 dsun = lambert_cos(base, rough, metal, spec, wo, float3(dot(ls, tb), dot(ls, bb), dot(ls, n)), dropCos) * P.sunIrr.xyz;
                            ld = ld + dsun;
                            lsp = lsp + (es.xyz * P.sunIrr.xyz - dsun);
                        } else { rr = rr + tw * es.xyz * P.sunIrr.xyz; }
                    }
                }
            }
            if (P.emitters > 0u) {
                const float2 ra = rand2(P.seedLo, P.seedHi, px, smp, dim + 2u);
                const float2 rb = rand2(P.seedLo, P.seedHi, px, smp, dim + 3u);
                const float want = ra.x * P.emitterArea;
                uint lo = 0u;
                uint hi = P.emitters;
                for (uint it = 0u; it < 32u; it++) {
                    if (lo >= hi) { break; }
                    const uint mid = (lo + hi) / 2u;
                    if (M[P.emitterOffset + mid * 2u + 1u] <= want) { lo = mid + 1u; } else { hi = mid; }
                }
                const uint et = uint(M[P.emitterOffset + min(lo, P.emitters - 1u) * 2u]);
                const float su = sqrt(ra.y);
                const float3 q = vtx(et, 0u) * (1.0f - su) + vtx(et, 1u) * (su * (1.0f - rb.x)) + vtx(et, 2u) * (su * rb.x);
                const float3 to = q - p;
                const float dist = length(to);
                const float3 wl = to * (1.0f / dist);
                const float cosL = abs(dot(normalize(cross(vtx(et, 1u) - vtx(et, 0u), vtx(et, 2u) - vtx(et, 0u))), wl));
                if (cosL > 0.0f) {
                    const float pl = dist * dist / (cosL * P.emitterArea);
                    const float4 ee = eval_bsdf(base, rough, metal, spec, wo, float3(dot(wl, tb), dot(wl, bb), dot(wl, n)), dropCos);
                    if (max(ee.x, max(ee.y, ee.z)) > 0.0f && trace(offset_p(p, ng, wl), wl, dist * (1.0f - 1e-3f), true).w < 0.0f) {
                        float wm = 1.0f;
                        if (!misOne) { wm = pl * pl / (pl * pl + ee.w * ee.w); }
                        const uint em = uint(A[et * 16u + 15u]) * 8u;
                        const float3 lem = float3(M[em + 4u], M[em + 5u], M[em + 6u]);
                        l = l + tp * ee.xyz * lem * (wm / pl);
                        if (b == 0u) {
                            const float3 dem = lambert_cos(base, rough, metal, spec, wo, float3(dot(wl, tb), dot(wl, bb), dot(wl, n)), dropCos) * lem * (wm / pl);
                            ld = ld + dem;
                            lsp = lsp + (ee.xyz * lem * (wm / pl) - dem);
                        } else { rr = rr + tw * ee.xyz * lem * (wm / pl); }
                    }
                }
            }
            // BSDF sampling.
            const float2 u = rand2(P.seedLo, P.seedHi, px, smp, dim);
            const float2 r = rand2(P.seedLo, P.seedHi, px, smp, dim + 1u);
            const float4 s = sample_bsdf(rough, metal, spec, wo, r.x, u.x, u.y);
            if (s.w <= 0.0f) { break; }
            const float4 e = eval_bsdf(base, rough, metal, spec, wo, s.xyz, dropCos);
            if (e.w <= 0.0f) { break; }
            tp = tp * e.xyz * (1.0f / e.w);
            if (b == 0u) {
                wd = lambert_cos(base, rough, metal, spec, wo, s.xyz, dropCos) * (1.0f / e.w);
                ws = e.xyz * (1.0f / e.w) - wd;
            } else { tw = tw * e.xyz * (1.0f / e.w); }
            prevPdf = e.w;
            if ((P.flags & F_RR) != 0u && b >= 3u) {
                const float qq = min(0.95f, max(tp.x, max(tp.y, tp.z)));
                if (r.y >= qq) { break; }
                tp = tp * (1.0f / qq);
                tw = tw * (1.0f / qq);
            }
            const float3 wi = tb * s.x + bb * s.y + n * s.z;
            ro = offset_p(p, ng, wi);
            rd = wi;
        }
        ACC[o] = ACC[o] + l.x; ACC[o + 1u] = ACC[o + 1u] + l.y; ACC[o + 2u] = ACC[o + 2u] + l.z;
        const float y = lum(l);
        const float cnt = ACC[o + 3u] + 1.0f;
        const float dl = y - ACC[o + 4u];
        ACC[o + 3u] = cnt;
        ACC[o + 4u] = ACC[o + 4u] + dl / cnt;
        ACC[o + 5u] = ACC[o + 5u] + dl * (y - ACC[o + 4u]);
        ld = ld + wd * rr;
        if ((P.flags & F_AOV_DROPSPEC) == 0u) { lsp = lsp + ws * rr; }
        if ((P.flags & F_AOV_EMDIFF) != 0u) { ld = ld + le0; le0 = ((float3)(0.0f)); }
        for (uint c = 0u; c < 3u; c++) {
            ACC[o + 16u + c] = ACC[o + 16u + c] + ld[c];
            ACC[o + 19u + c] = ACC[o + 19u + c] + lsp[c];
            ACC[o + 22u + c] = ACC[o + 22u + c] + le0[c];
        }
        const float yd = lum(ld);
        const float dd = yd - ACC[o + 31u];
        ACC[o + 31u] = ACC[o + 31u] + dd / cnt;
        ACC[o + 32u] = ACC[o + 32u] + dd * (yd - ACC[o + 31u]);
        const float ys = lum(lsp);
        const float ds = ys - ACC[o + 33u];
        ACC[o + 33u] = ACC[o + 33u] + ds / cnt;
        ACC[o + 34u] = ACC[o + 34u] + ds * (ys - ACC[o + 33u]);
    }
}
