# N2 native presentation (project-docs/RELEASE-PLAN.md, evidence/n2-presentation-bounds.json).
# Included by cmake/gpu.cmake inside the RAW_NATIVE_GPU_D3D12 block, after raw_native_d3d12
# exists. Builds raw_native_present: a Win32 window (src/platform/win32/), the D3D12 swapchain
# (in raw_native_d3d12) and the presentation host (src/tools/present/). Links user32 from the
# Windows SDK, nothing else; the default build is unchanged.
set(present_dir "${CMAKE_CURRENT_SOURCE_DIR}/src/tools/present")
set(present_gen "${CMAKE_CURRENT_BINARY_DIR}/gen-present")
# name|profile|entry|extra flags
set(present_entries
    "present_vs|vs_6_0|vs|" "present_scene|ps_6_0|scene_fs|" "present_blit|ps_6_0|blit_fs|"
    "present_pq|ps_6_0|pq_fs|-DPQ_CONTROL=0" "present_pq_control|ps_6_0|pq_fs|-DPQ_CONTROL=1")
set(present_headers "")
set(present_includes "")
set(present_table "")
foreach(e ${present_entries})
    string(REPLACE "|" ";" f "${e}")
    list(GET f 0 name)
    list(GET f 1 profile)
    list(GET f 2 entry)
    list(GET f 3 extra)
    set(h "${present_gen}/pdxil_${name}.h")
    add_custom_command(OUTPUT "${h}"
        COMMAND "${RAW_NATIVE_DXC}" -T ${profile} -E ${entry} -HV 2021 -Gis -O3 -Qstrip_debug -Qstrip_reflect ${extra}
                -Fh "${h}" -Vn "kPresentDxil_${name}" "${present_dir}/shaders/present.hlsl"
        DEPENDS "${present_dir}/shaders/present.hlsl" VERBATIM
        COMMENT "dxc present.hlsl (${name})")
    list(APPEND present_headers "${h}")
    string(APPEND present_includes "#include \"pdxil_${name}.h\"\n")
    string(APPEND present_table "    {\"${name}\", kPresentDxil_${name}, sizeof kPresentDxil_${name}},\n")
endforeach()
file(WRITE "${present_gen}/raw_present_dxil.hpp.tmp"
    "#pragma once\n// Generated by cmake/present.cmake. Do not edit.\n#include <cstddef>\n${present_includes}"
    "struct PresentDxilBlob { const char* name; const void* bytes; std::size_t size; };\n"
    "inline constexpr PresentDxilBlob kPresentDxil[] = {\n${present_table}};\n")
configure_file("${present_gen}/raw_present_dxil.hpp.tmp" "${present_gen}/raw_present_dxil.hpp" COPYONLY)

add_library(raw_native_present_host STATIC src/platform/win32/window_win32.cpp
    ${present_dir}/present_frames.cpp ${present_dir}/present_session.cpp ${present_dir}/present_host.cpp
    ${present_dir}/present_hdr.cpp ${present_dir}/present_pacing.cpp ${present_dir}/present_json.cpp
    ${present_dir}/present_selftest.cpp ${present_headers})
target_include_directories(raw_native_present_host PRIVATE "${present_gen}")
target_link_libraries(raw_native_present_host PUBLIC raw_native_d3d12 user32)
add_executable(raw_native_present app/present_main.cpp)
target_link_libraries(raw_native_present PRIVATE raw_native_present_host)
if(RAW_NATIVE_BUILD_TESTS)
    # A short pass of every N2 check on the adapter: presented against offscreen frames, the
    # control, resize, minimise, fullscreen, device removal and the HDR10 signal. Without an
    # adapter or a window it exits 77, which CTest reports as skipped, never as passed.
    add_test(NAME gpu_present_selftest COMMAND raw_native_present selftest)
    set_tests_properties(gpu_present_selftest PROPERTIES SKIP_RETURN_CODE 77)
endif()
