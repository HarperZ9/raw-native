# The native presentation host (project-docs/RELEASE-PLAN.md N2 and N3;
# evidence/n2-presentation-bounds.json, evidence/n3-vulkan-raster-bounds.json).
# raw_native_add_present(<suffix> <backend library> <dxil|spirv> <window sources> <window libraries>)
# builds raw_native_present<suffix>: a window, the backend's swapchain and the host in
# src/tools/present/. The passes are one HLSL file, compiled by the Windows SDK's dxc to DXIL
# (D3D12) or by glslang's HLSL front end to SPIR-V (Vulkan). The default build is unchanged.
include_guard(GLOBAL)
set(RAW_NATIVE_PRESENT_DIR "${CMAKE_CURRENT_LIST_DIR}/../src/tools/present")

# Compile the present passes to <gen>/raw_present_shaders.hpp: a table of named blobs and the format.
function(raw_native_present_shaders kind gen out_headers)
    set(src "${RAW_NATIVE_PRESENT_DIR}/shaders/present.hlsl")
    # name|stage|entry|define
    set(entries "present_vs|vs|vs|0" "present_scene|ps|scene_fs|0" "present_blit|ps|blit_fs|0"
                "present_pq|ps|pq_fs|0" "present_pq_control|ps|pq_fs|1")
    set(headers "")
    set(includes "")
    set(table "")
    foreach(e ${entries})
        string(REPLACE "|" ";" f "${e}")
        list(GET f 0 name)
        list(GET f 1 stage)
        list(GET f 2 entry)
        list(GET f 3 control)
        set(h "${gen}/present_${kind}_${name}.h")
        if(kind STREQUAL "dxil")
            add_custom_command(OUTPUT "${h}"
                COMMAND "${RAW_NATIVE_DXC}" -T ${stage}_6_0 -E ${entry} -HV 2021 -Gis -O3 -Qstrip_debug -Qstrip_reflect
                        -DPQ_CONTROL=${control} -Fh "${h}" -Vn "kPresent_${name}" "${src}"
                DEPENDS "${src}" VERBATIM COMMENT "dxc present.hlsl (${name})")
        else()
            if(stage STREQUAL "vs")
                set(vkstage vert)
            else()
                set(vkstage frag)
            endif()
            # Register shifts put each pass's bindings where the RHI layout has them: b0 -> 0, t0 -> 1, and
            # u0 -> 1 (a RWStructuredBuffer is an SSBO to glslang, so the SSBO shift moves it, not the UAV one).
            add_custom_command(OUTPUT "${h}"
                COMMAND Vulkan::glslangValidator -V -D -S ${vkstage} --sep ${entry} -e main
                        --shift-texture-binding ${vkstage} 1 --shift-ssbo-binding ${vkstage} 1
                        -DPQ_CONTROL=${control} --vn "kPresent_${name}" -o "${h}" "${src}"
                DEPENDS "${src}" VERBATIM COMMENT "glslang present.hlsl (${name})")
        endif()
        list(APPEND headers "${h}")
        string(APPEND includes "#include \"present_${kind}_${name}.h\"\n")
        string(APPEND table "    {\"${name}\", kPresent_${name}, sizeof kPresent_${name}},\n")
    endforeach()
    if(kind STREQUAL "dxil")
        set(format "raw::rhi::ShaderFormat::Dxil")
    else()
        set(format "raw::rhi::ShaderFormat::Spirv")
    endif()
    file(WRITE "${gen}/raw_present_shaders.hpp.tmp"
        "#pragma once\n// Generated by cmake/present.cmake. Do not edit.\n#include <cstddef>\n#include <cstdint>\n"
        "#include \"raw/rhi/rhi.hpp\"\n${includes}"
        "struct PresentShaderBlob { const char* name; const void* bytes; std::size_t size; };\n"
        "inline constexpr raw::rhi::ShaderFormat kPresentShaderFormat = ${format};\n"
        "inline constexpr PresentShaderBlob kPresentShaders[] = {\n${table}};\n")
    configure_file("${gen}/raw_present_shaders.hpp.tmp" "${gen}/raw_present_shaders.hpp" COPYONLY)
    set(${out_headers} ${headers} PARENT_SCOPE)
endfunction()

function(raw_native_add_present suffix backend kind window_sources window_libs)
    set(gen "${CMAKE_CURRENT_BINARY_DIR}/gen-present${suffix}")
    raw_native_present_shaders(${kind} "${gen}" headers)
    set(d "${RAW_NATIVE_PRESENT_DIR}")
    add_library(raw_native_present_host${suffix} STATIC ${window_sources}
        ${d}/present_frames.cpp ${d}/present_session.cpp ${d}/present_host.cpp
        ${d}/present_hdr.cpp ${d}/present_pacing.cpp ${d}/present_json.cpp
        ${d}/present_selftest.cpp ${headers})
    target_include_directories(raw_native_present_host${suffix} PRIVATE "${gen}")
    target_link_libraries(raw_native_present_host${suffix} PUBLIC ${backend} ${window_libs})
    add_executable(raw_native_present${suffix} "${CMAKE_CURRENT_SOURCE_DIR}/app/present_main.cpp")
    target_link_libraries(raw_native_present${suffix} PRIVATE raw_native_present_host${suffix})
    if(RAW_NATIVE_BUILD_TESTS)
        # A short pass of every presentation check on the adapter. Without an adapter or a window it
        # exits 77, which CTest reports as skipped, never as passed.
        add_test(NAME gpu_present${suffix}_selftest COMMAND raw_native_present${suffix} selftest)
        set_tests_properties(gpu_present${suffix}_selftest PROPERTIES SKIP_RETURN_CODE 77)
    endif()
endfunction()
