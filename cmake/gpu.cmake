# The RHI backends. A build links one, with the shader library in the format
# that backend takes. The default build links the null backend
# (src/rhi/null/), which answers --gpu with exit code 4 and an unverifiable
# certificate, and the library stays dependency-free.
#
#   RAW_NATIVE_GPU=ON        (Emscripten only) a second WebAssembly CLI,
#                            raw-native-gpu.mjs, built with Emscripten's WebGPU
#                            port and JSPI: src/rhi/webgpu/ and the WGSL passes.
#   RAW_NATIVE_GPU_D3D12=ON  (Windows only) raw_native_cli renders --gpu on
#                            D3D12: src/rhi/d3d12/. The passes are
#                            src/renderer/gpu/shaders/hlsl/*.hlsl, generated from
#                            the WGSL by scripts/wgsl_to_hlsl.py, compiled to DXIL
#                            by the Windows SDK's dxc.exe at build time. Links
#                            d3d12.lib, dxgi.lib and user32.lib (the swapchain's window
#                            and monitor queries, N2) from the Windows SDK; nothing else.
option(RAW_NATIVE_GPU "Build the WebGPU CLI (Emscripten only)" OFF)
option(RAW_NATIVE_GPU_D3D12 "Build the D3D12 backend into raw_native_cli (Windows only)" OFF)

set(RAW_NATIVE_SHADERS "${CMAKE_CURRENT_SOURCE_DIR}/src/renderer/gpu/shaders")
# Embed the WGSL sources as C++ raw strings.
function(raw_native_embed_wgsl out)
    file(READ "${RAW_NATIVE_SHADERS}/common.wgsl" common)
    file(READ "${RAW_NATIVE_SHADERS}/passes.wgsl" passes)
    file(READ "${RAW_NATIVE_SHADERS}/threads.wgsl" threads)
    file(READ "${RAW_NATIVE_SHADERS}/raster.wgsl" raster)
    file(READ "${RAW_NATIVE_SHADERS}/pbr.wgsl" pbr)
    file(READ "${RAW_NATIVE_SHADERS}/cube.wgsl" cube)
    file(READ "${RAW_NATIVE_SHADERS}/light.wgsl" light)
    file(READ "${RAW_NATIVE_SHADERS}/shadow.wgsl" shadow)
    file(READ "${RAW_NATIVE_SHADERS}/post.wgsl" post)
    file(READ "${RAW_NATIVE_SHADERS}/swr.wgsl" swr)
    file(READ "${RAW_NATIVE_SHADERS}/rt.wgsl" rt)
    file(READ "${RAW_NATIVE_SHADERS}/pt.wgsl" pt)
    file(READ "${RAW_NATIVE_SHADERS}/sdf.wgsl" sdf)
    file(READ "${RAW_NATIVE_SHADERS}/style.wgsl" style)
    # The art module: art.wgsl, then every art_*.wgsl in name order (as scripts/wgsl_to_hlsl.py reads it).
    file(READ "${RAW_NATIVE_SHADERS}/art.wgsl" art)
    file(GLOB art_parts "${RAW_NATIVE_SHADERS}/art_*.wgsl")
    list(SORT art_parts)
    foreach(part ${art_parts})
        file(READ "${part}" part_text)
        string(APPEND art "${part_text}")
    endforeach()
    file(WRITE "${out}.tmp"
        "#pragma once\n// Generated by cmake/gpu.cmake from src/renderer/gpu/shaders/*.wgsl. Do not edit.\n"
        "inline constexpr const char* kCommonWgsl = R\"WGSL(${common})WGSL\";\n"
        "inline constexpr const char* kPassesWgsl = R\"WGSL(${passes})WGSL\";\n"
        "inline constexpr const char* kThreadsWgsl = R\"WGSL(${threads})WGSL\";\n"
        "inline constexpr const char* kRasterWgsl = R\"WGSL(${raster})WGSL\";\n"
        "inline constexpr const char* kPbrWgsl = R\"WGSL(${pbr})WGSL\";\n"
        "inline constexpr const char* kCubeWgsl = R\"WGSL(${cube})WGSL\";\n"
        "inline constexpr const char* kLightWgsl = R\"WGSL(${light})WGSL\";\n"
        "inline constexpr const char* kShadowWgsl = R\"WGSL(${shadow})WGSL\";\n"
        "inline constexpr const char* kPostWgsl = R\"WGSL(${post})WGSL\";\n"
        "inline constexpr const char* kSwrWgsl = R\"WGSL(${swr})WGSL\";\n"
        "inline constexpr const char* kRtWgsl = R\"WGSL(${rt})WGSL\";\n"
        "inline constexpr const char* kPtWgsl = R\"WGSL(${pt})WGSL\";\n"
        "inline constexpr const char* kSdfWgsl = R\"WGSL(${sdf})WGSL\";\n"
        "inline constexpr const char* kStyleWgsl = R\"WGSL(${style})WGSL\";\n"
        "inline constexpr const char* kArtWgsl = R\"WGSL(${art})WGSL\";\n")
    configure_file("${out}.tmp" "${out}" COPYONLY)
endfunction()

