# Find dxc.exe in the Windows SDK: the SDK the build targets first, then the
# newest installed one.
function(raw_native_find_dxc)
    set(hints "")
    if(DEFINED ENV{WindowsSdkVerBinPath})
        list(APPEND hints "$ENV{WindowsSdkVerBinPath}/x64")
    endif()
    set(pf86 "ProgramFiles(x86)")
    set(kits "$ENV{${pf86}}/Windows Kits/10/bin")
    if(CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION)
        list(APPEND hints "${kits}/${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}/x64")
    endif()
    file(GLOB sdks LIST_DIRECTORIES true "${kits}/10.*")
    list(SORT sdks COMPARE NATURAL ORDER DESCENDING)
    foreach(s ${sdks})
        list(APPEND hints "${s}/x64")
    endforeach()
    find_program(RAW_NATIVE_DXC dxc HINTS ${hints} NO_DEFAULT_PATH)
    if(NOT RAW_NATIVE_DXC)
        message(FATAL_ERROR "RAW_NATIVE_GPU_D3D12 needs dxc.exe from the Windows SDK (10.0.18362 or newer); set RAW_NATIVE_DXC")
    endif()
endfunction()

# Compile each generated HLSL pass to DXIL and embed the bytes in a header.
# -HV 2021: short-circuit && and ||, as in WGSL. -Gis: strict IEEE float, no
# fast-math rewrites, to stay as close to the CPU reference as the driver allows.
function(raw_native_d3d12_shaders gen out_header)
    set(passes setup raster motion ssao rtao shade
        threads_init threads_rd_seed threads_rd threads_decay threads_advance threads_pyr_first threads_pyr_next threads_finish
        pbr_eval pbr_shade light_cluster light_prefilter shadow_lookup shadow_contact post_gtao post_ssr post_taa
        swr_setup swr_bin_count swr_bin_scan swr_bin_fill swr_tile swr_resolve swr_gbuffer
        rt_bounds_chunk rt_bounds_final rt_morton rt_sort_step rt_leaves rt_ploc_nn rt_ploc_flags
        rt_scan_chunk rt_scan_top rt_scan_add rt_ploc_merge rt_trace
        pt_trace pt_finish pt_hybrid
        sdf_march sdf_terms sdf_fog sdf_god sdf_composite
        style_ditherlight style_paintover style_exposure style_srgb_decode style_purity style_lightpaint style_glaze style_hatch style_hysteresis style_palettelight style_dither
        style_adj_prep style_adj_develop style_adj_chem style_adj_out
        style_crt_phosphor style_crt_down style_crt_box style_crt_add style_crt_tube
        style_vhs_sample style_vhs_tape style_vhs_play style_vhs_show
        style_fibre_field style_fibre_tensor style_fibre_init style_fibre_step style_fibre_out
        style_film_expose style_film_mtf style_film_halo_down style_film_halo_conv style_film_develop style_film_print
        style_lens_core style_lens_gather
        style_sag_current style_sag_scan style_sag_resample style_cari_sal style_cari_blur style_cari_grad style_cari_lambda style_cari_warp
        style_pixel_capture style_pixel_shade style_pixel_clear style_pixel_splatz style_pixel_splatid style_pixel_resolve
        style_paint_prep style_paint_tensor style_paint_blur style_paint_akf style_paint_stroke style_paint_relief style_paint_compose
        style_canvas_decide style_canvas_advect style_canvas_distort
        style_crtp_encode style_crtp_separate style_crtp_demod style_crtp_beam style_crtp_halo_down style_crtp_halo_conv style_crtp_compose)
    # The art module's passes: every generated hlsl/art_*.hlsl.
    file(GLOB art_hlsl CONFIGURE_DEPENDS "${RAW_NATIVE_SHADERS}/hlsl/art_*.hlsl")
    list(SORT art_hlsl)
    foreach(f ${art_hlsl})
        get_filename_component(n "${f}" NAME_WE)
        list(APPEND passes ${n})
    endforeach()
    set(headers "")
    set(includes "")
    set(table "")
    foreach(p ${passes})
        set(src "${RAW_NATIVE_SHADERS}/hlsl/${p}.hlsl")
        set(h "${gen}/dxil_${p}.h")
        add_custom_command(OUTPUT "${h}"
            COMMAND "${RAW_NATIVE_DXC}" -T cs_6_0 -E main -HV 2021 -Gis -O3 -Qstrip_debug -Qstrip_reflect
                    -Fh "${h}" -Vn "kDxil_${p}" "${src}"
            DEPENDS "${src}" VERBATIM
            COMMENT "dxc ${p}.hlsl")
        list(APPEND headers "${h}")
        string(APPEND includes "#include \"dxil_${p}.h\"\n")
        string(APPEND table "    {\"${p}\", kDxil_${p}, sizeof kDxil_${p}},\n")
    endforeach()
    # Raster passes: one HLSL file, compiled twice, as "<name>.vs" and "<name>.fs".
    set(rasters texture_identity fmt_pattern depth_tris gbuffer shadow_depth)
    foreach(p ${rasters})
        set(src "${RAW_NATIVE_SHADERS}/hlsl/${p}.hlsl")
        foreach(stage vs fs)
            if(stage STREQUAL "vs")
                set(profile vs_6_0)
            else()
                set(profile ps_6_0)
            endif()
            set(h "${gen}/dxil_${p}_${stage}.h")
            add_custom_command(OUTPUT "${h}"
                COMMAND "${RAW_NATIVE_DXC}" -T ${profile} -E ${stage} -HV 2021 -Gis -O3 -Qstrip_debug -Qstrip_reflect
                        -Fh "${h}" -Vn "kDxil_${p}_${stage}" "${src}"
                DEPENDS "${src}" VERBATIM
                COMMENT "dxc ${p}.hlsl (${stage})")
            list(APPEND headers "${h}")
            string(APPEND includes "#include \"dxil_${p}_${stage}.h\"\n")
            string(APPEND table "    {\"${p}.${stage}\", kDxil_${p}_${stage}, sizeof kDxil_${p}_${stage}},\n")
        endforeach()
    endforeach()
    file(WRITE "${out_header}.tmp"
        "#pragma once\n// Generated by cmake/gpu.cmake. Do not edit.\n#include <cstddef>\n${includes}"
        "struct DxilBlob { const char* name; const void* bytes; std::size_t size; };\n"
        "inline constexpr DxilBlob kDxil[] = {\n${table}};\n")
    configure_file("${out_header}.tmp" "${out_header}" COPYONLY)
    set(RAW_NATIVE_DXIL_HEADERS ${headers} PARENT_SCOPE)
endfunction()

# HW workstream (evidence/hw-*-bounds.json): hand-written HLSL in src/rhi/d3d12/hw_shaders/,
# each with its own profile and flags, embedded in raw_hw_dxil.hpp for src/rhi/d3d12/hw_*.cpp.
function(raw_native_hw_shaders gen out_header)
    set(dir "${CMAKE_CURRENT_SOURCE_DIR}/src/rhi/d3d12/hw_shaders")
    # name|source|profile|extra flags|entry point (flags are space-separated; entry defaults to main)
    set(entries
        "hw_scan_wave|hw_scan_wave|cs_6_0|"
        "hw_scan_shared|hw_scan_shared|cs_6_0|"
        "hw_half|hw_half|cs_6_2|-enable-16bit-types"
        "hw_half_fallback|hw_half_fallback|cs_6_0|"
        "hw_rayquery_probe|hw_rayquery_probe|cs_6_5|"
        "hw_rayquery|hw_rayquery|cs_6_5|"
        "hw_scan_level_shared|hw_scan_level|cs_6_0|-DMODE=0 -DDROP=0" "hw_scan_level_wave|hw_scan_level|cs_6_0|-DMODE=1 -DDROP=0"
        "hw_scan_level_drop|hw_scan_level|cs_6_0|-DMODE=1 -DDROP=1" "hw_scan_add|hw_scan_add|cs_6_0|"
        "hw_bilateral_fp32|hw_bilateral|cs_6_0|-DMODE=0" "hw_bilateral_fp16|hw_bilateral|cs_6_2|-enable-16bit-types -DMODE=1"
        "hw_mesh_vs|hw_mesh|vs_6_5||vs" "hw_mesh_as|hw_mesh|as_6_5||as" "hw_mesh_as_flip|hw_mesh|as_6_5|-DCONE_FLIP=1|as"
        "hw_mesh_ms|hw_mesh|ms_6_5||ms" "hw_mesh_ps|hw_mesh|ps_6_5||ps"
        "hw_async_p|hw_async|cs_6_0|-DMODE=0" "hw_async_w|hw_async|cs_6_0|-DMODE=1" "hw_async_c|hw_async|cs_6_0|-DMODE=2"
        "hw_busy|hw_busy|cs_6_0|-DFLAT=0"
        "hw_busy_flat|hw_busy|cs_6_0|-DFLAT=1")
    set(headers "")
    set(includes "")
    set(table "")
    foreach(e ${entries})
        string(REPLACE "|" ";" f "${e}")
        list(GET f 0 name)
        list(GET f 1 src)
        list(GET f 2 profile)
        list(LENGTH f nf)
        set(extra "")
        if(nf GREATER 3)
            list(GET f 3 extra)
            separate_arguments(extra)
        endif()
        set(entry main)   # optional fifth field: the entry point
        if(nf GREATER 4)
            list(GET f 4 entry)
        endif()
        set(h "${gen}/hwdxil_${name}.h")
        add_custom_command(OUTPUT "${h}"
            COMMAND "${RAW_NATIVE_DXC}" -T ${profile} -E ${entry} -HV 2021 -Gis -O3 -Qstrip_debug -Qstrip_reflect ${extra}
                    -Fh "${h}" -Vn "kHwDxil_${name}" "${dir}/${src}.hlsl"
            DEPENDS "${dir}/${src}.hlsl" VERBATIM
            COMMENT "dxc ${src}.hlsl (${name})")
        list(APPEND headers "${h}")
        string(APPEND includes "#include \"hwdxil_${name}.h\"
")
        string(APPEND table "    {\"${name}\", kHwDxil_${name}, sizeof kHwDxil_${name}},
")
    endforeach()
    file(WRITE "${out_header}.tmp"
        "#pragma once
// Generated by cmake/gpu.cmake. Do not edit.
#include <cstddef>
${includes}"
        "struct HwDxilBlob { const char* name; const void* bytes; std::size_t size; };
"
        "inline constexpr HwDxilBlob kHwDxil[] = {
${table}};
")
    configure_file("${out_header}.tmp" "${out_header}" COPYONLY)
    set(RAW_NATIVE_HW_DXIL_HEADERS ${headers} PARENT_SCOPE)
endfunction()

