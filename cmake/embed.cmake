# Embeds the committed anisotropic split-albedo table (src/renderer/data/aniso_albedo.f32,
# generated once by tools/pbr_tables/aniso_gen.cpp; method note 4 of 2026-10-12 in
# evidence/m3-materials2-bounds.json) into the library as a byte array, at configure time,
# so a build needs neither Python nor the generator. Reconfigures when the file changes.
# A missing file embeds zero bytes: the generator still builds, and Tables() stops with a
# message instead of reading a table that does not exist.
function(raw_native_embed_aniso_table src out)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${src}")
    set(bytes "")
    set(count 0)
    if(EXISTS "${src}")
        file(SIZE "${src}" count)
        file(READ "${src}" hex HEX)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        # One line per 32 bytes keeps the source readable by tools that limit line length.
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
    else()
        message(WARNING "${src} is missing: build the table with tools/pbr_tables/aniso_gen.cpp")
    endif()
    set(body "// Generated by cmake/embed.cmake from src/renderer/data/aniso_albedo.f32. Do not edit.\n")
    string(APPEND body "#include \"raw/renderer/pbr.hpp\"\n#include <cstddef>\nnamespace raw::pbr {\nnamespace {\n")
    string(APPEND body "alignas(4) const unsigned char kAnisoTable[] = {\n${bytes}0x00};\n}  // namespace\n")
    string(APPEND body "const unsigned char* Tables::anisoBytes() { return kAnisoTable; }\n")
    string(APPEND body "std::size_t Tables::anisoByteCount() { return ${count}; }\n}  // namespace raw::pbr\n")
    set(old "")
    if(EXISTS "${out}")
        file(READ "${out}" old)
    endif()
    if(NOT old STREQUAL body)
        file(WRITE "${out}" "${body}")
    endif()
endfunction()
